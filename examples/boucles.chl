// boucles.chl — répéter des instructions.
//
// Montre : while, for … in a..b, for … in tableau, break, continue,
// boucles imbriquées.
// Sur le PC : chili run boucles.chl  (firmware 0.3.0 sur la carte)

class Main {
    function main() {
        // while : tant que la condition est vraie
        let n = 1
        while n < 100 {
            n *= 2
        }
        print(n)                            // 128

        // for … in a..b : de a jusqu'à b - 1
        let somme = 0
        for i in 1..11 {
            somme += i
        }
        print(somme)                        // 55 = 1 + 2 + … + 10

        // for … in tableau : chaque valeur, dans l'ordre
        for note in [262, 294, 330] {
            print(note)
        }

        // continue : passe au tour suivant ; break : sort de la boucle
        for i in 0..100 {
            if i % 2 == 0 {
                continue                    // saute les nombres pairs
            }
            if i > 9 {
                break                       // s'arrête après 9
            }
            print(i)                        // 1 3 5 7 9
        }

        // Boucles imbriquées : une table de multiplication
        for ligne in 1..4 {
            let texte = ""
            for colonne in 1..4 {
                texte = texte + ligne * colonne + " "
            }
            print(texte)                    // 1 2 3 / 2 4 6 / 3 6 9
        }
    }
}
