// bouton.chl — allume la LED tant qu'on appuie sur le bouton BOOT.
//
// Montre : gpio.read, une entrée avec pull-up (mode 2), if / else.
// Matériel : le bouton BOOT (GPIO 0) et la LED intégrée (GPIO 2).
// Le bouton relie la broche à la masse : relâché, elle lit 1 (grâce au
// pull-up interne) ; appuyé, elle lit 0.

let bouton = 0
let led = 2

class Main {
    function main() {
        gpio.mode(bouton, 2) // 2 = entrée avec pull-up
        gpio.mode(led, 1)    // 1 = sortie

        while true {
            if gpio.read(bouton) == 0 {
                gpio.write(led, 1)
            } else {
                gpio.write(led, 0)
            }
            delay(10) // 100 lectures par seconde suffisent
        }
    }
}
