// compteur.chl — compte les appuis sur le bouton BOOT et affiche le total.
//
// Montre : détecter un appui (passage de relâché à appuyé) en gardant
// l'état précédent, éviter les rebonds, print.
// Matériel : le bouton BOOT (GPIO 0). Regarde la console (chili monitor).

let bouton = 0

class Main {
    function main() {
        gpio.mode(bouton, 2) // entrée avec pull-up : 1 = relâché, 0 = appuyé

        let appuis = 0
        let avant = 1 // état précédent du bouton

        while true {
            let etat = gpio.read(bouton)
            if avant == 1 && etat == 0 { // un appui = passage de 1 à 0
                appuis += 1
                print("appuis : " + appuis)
            }
            avant = etat
            delay(20) // évite de compter les rebonds du bouton
        }
    }
}
