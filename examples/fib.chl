// fib.chl — affiche les 15 premiers nombres de Fibonacci
// et le temps de calcul de fib(25) en récursif.

fn fib(n) {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn main() {
    let i = 0
    while i < 15 {
        print(fib(i))
        i += 1
    }

    let t0 = millis()
    print(fib(25))
    print(millis() - t0)
}
