// de.chl — un dé électronique : à chaque appui sur le bouton BOOT (GPIO 0),
// la LED (GPIO 2) clignote autant de fois que le nombre tiré, de 1 à 6.

let led = 2
let bouton = 0

function clignote(fois) {
    let i = 0
    while i < fois {
        gpio.write(led, 1)
        delay(200)
        gpio.write(led, 0)
        delay(200)
        i += 1
    }
}

class Main {
    function main() {
        gpio.mode(led, 1)
        gpio.mode(bouton, 2)    // entrée avec résistance de rappel : 0 quand on appuie
        while true {
            if gpio.read(bouton) == 0 {
                let tirage = random(1, 6)
                print(tirage)
                clignote(tirage)
                delay(300)      // laisse le temps de relâcher le bouton
            }
            delay(20)
        }
    }
}
