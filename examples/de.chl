// de.chl — un dé électronique.
//
// Montre : random(min, max), une fonction avec paramètre, une boucle for.
// Matériel : le bouton BOOT (GPIO 0) et la LED intégrée (GPIO 2).
// À chaque appui, la LED clignote autant de fois que le nombre tiré (1 à 6).

let led = 2
let bouton = 0

function clignote(fois) {
    for i in 0..fois {
        gpio.write(led, 1)
        delay(200)
        gpio.write(led, 0)
        delay(200)
    }
}

class Main {
    function main() {
        gpio.mode(led, 1)
        gpio.mode(bouton, 2)    // entrée avec pull-up : 0 quand on appuie
        while true {
            if gpio.read(bouton) == 0 {
                let tirage = random(1, 6)
                print("dé : " + tirage)
                clignote(tirage)
                delay(300)      // laisse le temps de relâcher le bouton
            }
            delay(20)
        }
    }
}
