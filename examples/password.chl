// password.chl — générateur de mot de passe aléatoire.
//
// Chaque caractère est tiré au hasard, puis affiché avec printc (qui prend
// le code du caractère : 97 = a, 65 = A, 48 = 0…). println termine la ligne.

// Les caractères autorisés : a-z, A-Z, 0-9 et 12 symboles, soit 74 caractères.
class Alphabet {
    function taille() {
        return 74
    }

    // Traduit un numéro de 0 à 73 en code de caractère.
    function code(i) {
        if i < 26 { return 97 + i }        // 0-25  → a-z
        if i < 52 { return 65 + i - 26 }   // 26-51 → A-Z
        if i < 62 { return 48 + i - 52 }   // 52-61 → 0-9
        return this.symbole(i - 62)        // 62-73 → symboles
    }

    // Les 12 symboles : ! # $ % & * + - = ? @ _
    function symbole(k) {
        if k == 0 { return 33 }    // !
        if k == 1 { return 35 }    // #
        if k == 2 { return 36 }    // $
        if k == 3 { return 37 }    // %
        if k == 4 { return 38 }    // &
        if k == 5 { return 42 }    // *
        if k == 6 { return 43 }    // +
        if k == 7 { return 45 }    // -
        if k == 8 { return 61 }    // =
        if k == 9 { return 63 }    // ?
        if k == 10 { return 64 }   // @
        return 95                  // _
    }
}

class Generateur {
    let alphabet
    let longueur

    constructor(alphabet, longueur) {
        this.alphabet = alphabet
        this.longueur = longueur
    }

    // Tire un caractère au hasard dans l'alphabet.
    function caractere() {
        let i = random(0, this.alphabet.taille() - 1)
        return this.alphabet.code(i)
    }

    // Affiche le mot de passe sur une ligne.
    function generer() {
        let n = 0
        while n < this.longueur {
            printc(this.caractere())
            n += 1
        }
        println()
    }
}

class Main {
    function main() {
        let generateur = new Generateur(new Alphabet(), 12)
        generateur.generer()
    }
}
