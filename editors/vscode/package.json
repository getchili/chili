{
  "name": "chili-lang",
  "displayName": "Chili",
  "description": "Langage Chili (.chl) : coloration, snippets et erreurs de syntaxe soulignées",
  "version": "0.2.0",
  "publisher": "chili",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:chili"
  ],
  "contributes": {
    "languages": [
      {
        "id": "chili",
        "aliases": [
          "Chili",
          "chili"
        ],
        "extensions": [
          ".chl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/chili.svg",
          "dark": "./icons/chili.svg"
        }
      },
      {
        "id": "chili-bytecode",
        "aliases": [
          "Chili bytecode"
        ],
        "extensions": [
          ".chlb"
        ],
        "icon": {
          "light": "./icons/chili-bytecode.svg",
          "dark": "./icons/chili-bytecode.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "chili",
        "scopeName": "source.chili",
        "path": "./syntaxes/chili.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "chili",
        "path": "./snippets/chili.json"
      }
    ],
    "configuration": {
      "title": "Chili",
      "properties": {
        "chili.path": {
          "type": "string",
          "default": "",
          "description": "Chemin de chili.exe. Vide : la commande « chili » du PATH."
        },
        "chili.check.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Vérifier le fichier avec « chili check » et souligner les erreurs."
        }
      }
    }
  }
}
