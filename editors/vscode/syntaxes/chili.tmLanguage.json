{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Chili",
  "scopeName": "source.chili",
  "fileTypes": ["chl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#class-declaration" },
    { "include": "#function-declaration" },
    { "include": "#constructor" },
    { "include": "#new-expression" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#native-calls" },
    { "include": "#member-access" },
    { "include": "#language-variables" },
    { "include": "#calls" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "match": "//.*$",
      "name": "comment.line.double-slash.chili"
    },
    "class-declaration": {
      "match": "\\b(?:(abstract)\\s+)?(class)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(extends)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
      "captures": {
        "1": { "name": "storage.modifier.abstract.chili" },
        "2": { "name": "storage.type.class.chili" },
        "3": { "name": "entity.name.type.class.chili" },
        "4": { "name": "storage.modifier.extends.chili" },
        "5": { "name": "entity.other.inherited-class.chili" }
      }
    },
    "function-declaration": {
      "match": "\\b(?:(abstract)\\s+)?(function)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.modifier.abstract.chili" },
        "2": { "name": "storage.type.function.chili" },
        "3": { "name": "entity.name.function.chili" }
      }
    },
    "constructor": {
      "match": "\\b(constructor)\\b",
      "name": "storage.type.constructor.chili"
    },
    "new-expression": {
      "match": "\\b(new)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.operator.new.chili" },
        "2": { "name": "entity.name.type.class.chili" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(if|else|while)\\b",
          "name": "keyword.control.conditional.chili"
        },
        {
          "match": "\\b(return|break|continue)\\b",
          "name": "keyword.control.flow.chili"
        },
        {
          "match": "\\b(let)\\b",
          "name": "storage.type.chili"
        },
        {
          "match": "\\b(function)\\b",
          "name": "storage.type.function.chili"
        },
        {
          "match": "\\b(class)\\b",
          "name": "storage.type.class.chili"
        },
        {
          "match": "\\b(abstract)\\b",
          "name": "storage.modifier.abstract.chili"
        },
        {
          "match": "\\b(extends)\\b",
          "name": "storage.modifier.extends.chili"
        },
        {
          "match": "\\b(new)\\b",
          "name": "keyword.operator.new.chili"
        }
      ]
    },
    "constants": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.chili"
    },
    "numbers": {
      "patterns": [
        { "match": "\\b0[xX][0-9A-Fa-f_]+\\b", "name": "constant.numeric.hex.chili" },
        { "match": "\\b0[bB][01_]+\\b", "name": "constant.numeric.binary.chili" },
        { "match": "\\b[0-9][0-9_]*\\b", "name": "constant.numeric.decimal.chili" }
      ]
    },
    "native-calls": {
      "patterns": [
        {
          "match": "\\b(gpio)\\s*(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.namespace.chili" },
            "2": { "name": "punctuation.accessor.chili" },
            "3": { "name": "support.function.chili" }
          }
        },
        {
          "match": "\\b(print|printc|println|delay|millis|random)\\b(?=\\s*\\()",
          "name": "support.function.builtin.chili"
        }
      ]
    },
    "member-access": {
      "patterns": [
        {
          "comment": "x.m( : appel de méthode (this.m(, super.m(, obj.m()",
          "match": "\\b(?:(this|super)|([A-Za-z_][A-Za-z0-9_]*))\\s*(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "variable.language.this.chili" },
            "2": { "name": "variable.other.object.chili" },
            "3": { "name": "punctuation.accessor.chili" },
            "4": { "name": "entity.name.function.member.chili" }
          }
        },
        {
          "comment": "this.champ : champ privé",
          "match": "\\b(this|super)\\s*(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "variable.language.this.chili" },
            "2": { "name": "punctuation.accessor.chili" },
            "3": { "name": "variable.other.property.chili" }
          }
        }
      ]
    },
    "language-variables": {
      "match": "\\b(this|super)\\b",
      "name": "variable.language.this.chili"
    },
    "calls": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.chili" }
      }
    },
    "operators": {
      "patterns": [
        { "match": "(\\+|-|\\*|/|%)=", "name": "keyword.operator.assignment.compound.chili" },
        { "match": "==|!=|<=|>=|<(?!<)|>(?!>)", "name": "keyword.operator.comparison.chili" },
        { "match": "&&|\\|\\||!", "name": "keyword.operator.logical.chili" },
        { "match": "<<|>>|&|\\||\\^|~", "name": "keyword.operator.bitwise.chili" },
        { "match": "\\+|-|\\*|/|%", "name": "keyword.operator.arithmetic.chili" },
        { "match": "=", "name": "keyword.operator.assignment.chili" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "match": ",", "name": "punctuation.separator.comma.chili" },
        { "match": ";", "name": "punctuation.terminator.statement.chili" },
        { "match": "\\.", "name": "punctuation.accessor.chili" }
      ]
    },
    "variables": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
      "name": "variable.other.chili"
    }
  }
}
